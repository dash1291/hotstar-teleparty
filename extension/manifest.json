{
  "manifest_version": 3,
  "name": "Hotstar Party",
  "version": "0.2.0",
  "description": "Watch Hotstar together: play, pause and seek in sync, with chat.",
  "permissions": ["storage"],
  "host_permissions": ["https://*.hotstar.com/*"],
  "content_scripts": [
    {
      "matches": ["https://*.hotstar.com/*"],
      "js": ["defaults.js", "content.js"],
      "css": ["party.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hotstar Party"
  }
}
